# Optional OpenAI-compatible LLM config for text extraction/rerank
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Optional Gemini multimodal OCR/extraction for PDFs/images
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Server config
PORT=8095
DATA_DIR=./data

# Access token for query endpoints (/api/search, /api/job-match)
# Leave empty to allow open access. Set to a random string to require Bearer auth.
ACCESS_TOKEN=

# Rate limiting (per-IP token bucket)
RATE_LIMIT_RPM=30
RATE_LIMIT_BURST=5
